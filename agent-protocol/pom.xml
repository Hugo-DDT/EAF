        <dependency><groupId>io.eaf</groupId><artifactId>eaf-task</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.eaf</groupId><artifactId>eaf-agent-runtime</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.eaf</groupId><artifactId>eaf-audit</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.eaf</groupId><artifactId>eaf-evaluation</artifactId><version>${project.version}</version></dependency>
