        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
        <!-- MCP SDK 固定在协议适配边界，Jackson 2 与当前 Spring Boot 主栈一致。 -->
        <dependency><groupId>io.modelcontextprotocol.sdk</groupId><artifactId>mcp-core</artifactId><version>2.0.1</version></dependency>
        <dependency><groupId>io.modelcontextprotocol.sdk</groupId><artifactId>mcp-json-jackson2</artifactId><version>2.0.1</version></dependency>
        <!-- A2A wire DTO 仅留在协议边界；此处只引入 Schema 模型，不带入传输服务器。 -->
        <dependency><groupId>org.a2aproject.sdk</groupId><artifactId>a2a-java-sdk-spec</artifactId><version>1.3.2.Final</version></dependency>
    </dependencies>
</project>
