        <dependency><groupId>io.eaf</groupId><artifactId>eaf-learning</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.eaf</groupId><artifactId>eaf-tool</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.eaf</groupId><artifactId>eaf-skill</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.eaf</groupId><artifactId>eaf-capability</artifactId><version>${project.version}</version></dependency>
