        <dependency><groupId>io.eaf</groupId><artifactId>eaf-memory</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.eaf</groupId><artifactId>eaf-execution</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.eaf</groupId><artifactId>eaf-approval</artifactId><version>${project.version}</version></dependency>
