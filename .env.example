# 本机开发配置示例；复制为 .env 后按需修改，禁止填写后提交真实秘密。
EAF_DB_URL=jdbc:postgresql://localhost:15432/eaf
EAF_DB_USERNAME=eaf
EAF_DB_PASSWORD=change-this-local-password

# 确定性模式为默认值；真实模型参数和凭据统一从环境读取。
EAF_MODEL_MODE=deterministic
EAF_MODEL_LIVE_PROVIDER=deepseek
EAF_MODEL_PROFILE=deepseek-official-flash
EAF_MODEL_LIVE_MODEL=deepseek-flash
EAF_MODEL_LIVE_TEMPERATURE=0.0
EAF_MODEL_LIVE_BASE_URL=https://api.deepseek.com
EAF_MODEL_LIVE_CHAT_COMPLETIONS_PATH=/chat/completions
EAF_MODEL_LIVE_CREDENTIAL_REF=model-deepseek
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
EAF_MODEL_LIVE_DATA_AUTHORIZED=false
EAF_MODEL_LIVE_OUTBOUND_DATA_SCOPE=synthetic-evaluation-only
EAF_MODEL_LIVE_FEE_CAP=1.00
EAF_MODEL_LIVE_FEE_CURRENCY=USD
EAF_MODEL_LIVE_RUN_OWNER=local-operator
EAF_MODEL_LIVE_AUTHORIZATION_ID=
EAF_MODEL_LIVE_AUTHORIZATION_EXPIRY=
EAF_MODEL_LIVE_STOP_CONDITION=CAP_REACHED,UNKNOWN_COST,SAFETY_VIOLATION,HUMAN_STOP

# P8 类型化分类默认关闭；确定性替身不出站，真实模式须填完本轮 TypeSafe 授权。
EAF_MODEL_JEV_MODE=disabled
EAF_MODEL_JEV_EVIDENCE_MODE=disabled
EAF_MODEL_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
EAF_MODEL_JEV_MODEL=jev-1.13.0
EAF_MODEL_JEV_DATA_AUTHORIZED=false
EAF_MODEL_JEV_OUTBOUND_DATA_SCOPE=synthetic-customer-summary-only
EAF_MODEL_JEV_RUN_OWNER=local-operator
EAF_MODEL_JEV_AUTHORIZATION_ID=
EAF_MODEL_JEV_AUTHORIZATION_EXPIRY=
TYPESAFE_API_KEY=

# HTTP 传输边界也可由环境收紧。
EAF_MODEL_HTTP_CONNECT_TIMEOUT=2s
EAF_MODEL_HTTP_READ_TIMEOUT=20s
